{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "security-canvas",
  "description": "Cross-pillar agent security triage for a Microsoft tenant. Inventories the agents in your estate, explains why Entra flagged one as risky, weighs identity risk against Purview data exposure and GitHub code access, and hands back a Purview DLP playbook.",
  "author": {
    "name": "Freddy Diaz",
    "url": "https://github.com/FreddyJD"
  },
  "homepage": "https://github.com/FreddyJD/security-canvas-poc",
  "repository": "https://github.com/FreddyJD/security-canvas-poc",
  "license": "MIT",
  "keywords": [
    "security",
    "microsoft",
    "entra",
    "purview",
    "defender",
    "agent-security",
    "risk-triage",
    "mcp"
  ],
  "mcpServers": {
    "security-canvas": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp.mjs"
      ],
      "env": {
        "SECURITY_CANVAS_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
