{
  "name": "security-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-pillar agent security triage for Microsoft Entra, Purview, Defender and GitHub — exposed as MCP tools.",
  "license": "MIT",
  "bin": {
    "security-canvas": "./mcp.mjs"
  },
  "files": [
    "extension.mjs",
    "mcp.mjs",
    "dist",
    "features",
    "platform"
  ],
  "scripts": {
    "start": "node mcp.mjs",
    "build": "node scripts/build-mcp.mjs",
    "build:check": "node scripts/build-mcp.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node mcp.mjs",
    "test:e2e": "node test/e2e-smoke.mjs",
    "test:panel": "node test/panel-smoke.mjs",
    "preview": "node test/panel-preview.mjs --risky",
    "preview:live": "node test/panel-preview-live.mjs",
    "preview:details": "node test/details-preview.mjs",
    "preview:app": "node test/app-preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
